import "fonts/DMSans-Light.ttf";
import "fonts/DMSans-Regular.ttf";
import "fonts/DMSans-SemiBold.ttf";
import "fonts/DMSans-Bold.ttf";
import { Theme } from "theme.slint";
import { Backend } from "state.slint";
import { LoginScreen, SetupScreen } from "auth.slint";
import { Shell } from "shell.slint";
import { FadeIn } from "components.slint";
import { SettingsPage, RestoreDialog, ImportDialog } from "settings.slint";
import { AnnouncementsPage, AnnouncementPage, NewAnnouncementDialog, QueueConfirmDialog } from "announcements.slint";
import { FinancesPage, ChargeDialog, ClassifyDialog, PaymentDialog, TagDialog, TagRemoveDialog, ReportDialog } from "finances.slint";
import { ProvidersPage, ProviderDialog, ProviderTagDialog, ProviderRemoveDialog } from "providers.slint";
import { OverviewPage, UnitsPage, PeoplePage, UnitDialog, OnboardDialog, OffboardDialog, EditPersonDialog, DetailDialog } from "residency.slint";

export { Backend, UnitRow, RelationRow, StatCard, ActivityRow, TxRow, AccountRow, ChargeRow, TagRow, ProviderRow, ProviderTagRow, ProviderDraft, ProviderTagDraft, BreakdownRow, MatchRow, TagDraft, ReportSection, AnnRow, JobRow } from "state.slint";

export component AppWindow inherits Window {
    title: "Meu Condomínio";
    default-font-family: "DM Sans";
    icon: @image-url("icons/building-2.svg");
    preferred-width: 1360px;
    preferred-height: 800px;
    min-width: 1180px;
    min-height: 600px;
    background: Theme.page;

    if Backend.screen == "login": LoginScreen {
        width: parent.width;
        height: parent.height;
    }
    if Backend.screen == "setup": SetupScreen {
        width: parent.width;
        height: parent.height;
    }
    if Backend.screen == "main": Shell {
        width: parent.width;
        height: parent.height;
        Rectangle {
            vertical-stretch: 1;
            if Backend.page == "overview": FadeIn {
                width: parent.width;
                height: parent.height;
                OverviewPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if Backend.page == "units": FadeIn {
                width: parent.width;
                height: parent.height;
                UnitsPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if Backend.page == "people": FadeIn {
                width: parent.width;
                height: parent.height;
                PeoplePage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if Backend.page == "finances": FadeIn {
                width: parent.width;
                height: parent.height;
                FinancesPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if Backend.page == "providers": FadeIn {
                width: parent.width;
                height: parent.height;
                ProvidersPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if Backend.page == "announcements": FadeIn {
                width: parent.width;
                height: parent.height;
                AnnouncementsPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if Backend.page == "announcement": FadeIn {
                width: parent.width;
                height: parent.height;
                AnnouncementPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if Backend.page == "settings": FadeIn {
                width: parent.width;
                height: parent.height;
                SettingsPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
    }

    if Backend.screen == "main" && Backend.dialog == "unit": UnitDialog {
        width: parent.width;
        height: parent.height;
    }
    if Backend.screen == "main" && Backend.dialog == "onboard": OnboardDialog {
        width: parent.width;
        height: parent.height;
    }
    if Backend.screen == "main" && Backend.dialog == "offboard": OffboardDialog {
        width: parent.width;
        height: parent.height;
    }
    if Backend.screen == "main" && Backend.dialog == "edit-person": EditPersonDialog {
        width: parent.width;
        height: parent.height;
    }
    if Backend.screen == "main" && Backend.dialog == "detail": DetailDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "restore": RestoreDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "import": ImportDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "charge": ChargeDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "classify": ClassifyDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "payment": PaymentDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "tag": TagDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "tag-remove": TagRemoveDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "report": ReportDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "provider": ProviderDialog {
        width: parent.width;
        height: parent.height;
    }
    if Backend.screen == "main" && Backend.dialog == "provider-tag": ProviderTagDialog {
        width: parent.width;
        height: parent.height;
    }
    if Backend.screen == "main" && Backend.dialog == "provider-remove": ProviderRemoveDialog {
        width: parent.width;
        height: parent.height;
    }

    if Backend.screen == "main" && Backend.dialog == "new-announcement": NewAnnouncementDialog {
        width: parent.width;
        height: parent.height;
    }
    if Backend.screen == "main" && Backend.dialog == "queue-confirm": QueueConfirmDialog {
        width: parent.width;
        height: parent.height;
    }
}
