import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Backend } from "state.slint";
import { Icon, IconButton, Avatar, NavItem, Notice, AppButton } from "components.slint";

// Sidebar + top bar around whichever page is shown.
export component Shell inherits Rectangle {
    background: Theme.page;

    HorizontalLayout {
        // --- Sidebar -------------------------------------------------------------------
        Rectangle {
            width: 248px;
            background: Theme.surface;
            border-width: 0px;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }

            VerticalLayout {
                padding: 20px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 18px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 9px;
                        background: Theme.green;
                        Icon {
                            source: Icons.building;
                            tint: Theme.on-green;
                            size: 22px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 0px;
                            alignment: start;
                            Text {
                                text: "meu";
                                font-size: 18px;
                                font-weight: 700;
                                color: Theme.text;
                            }

                            Text {
                                text: "condomínio";
                                font-size: 18px;
                                font-weight: 300;
                                color: Theme.text;
                            }
                        }

                        Text {
                            text: "ESPAÇO DE GESTÃO";
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.muted;
                        }
                    }
                }

                Text {
                    text: "PRINCIPAL";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.muted;
                }

                NavItem {
                    icon: Icons.dashboard;
                    text: "Visão geral";
                    active: Backend.page == "overview";
                    clicked => {
                        Backend.navigate("overview");
                    }
                }

                NavItem {
                    icon: Icons.door;
                    text: "Frações";
                    active: Backend.page == "units";
                    clicked => {
                        Backend.navigate("units");
                    }
                }

                NavItem {
                    icon: Icons.users;
                    text: "Pessoas";
                    active: Backend.page == "people";
                    clicked => {
                        Backend.navigate("people");
                    }
                }

                NavItem {
                    icon: Icons.wallet;
                    text: "Finanças";
                    active: Backend.page == "finances";
                    clicked => {
                        Backend.navigate("finances");
                    }
                }

                NavItem {
                    icon: Icons.briefcase;
                    text: "Fornecedores";
                    active: Backend.page == "providers";
                    clicked => {
                        Backend.navigate("providers");
                    }
                }

                NavItem {
                    icon: Icons.mail;
                    text: "Comunicados";
                    active: Backend.page == "announcements" || Backend.page == "announcement";
                    clicked => {
                        Backend.navigate("announcements");
                    }
                }

                Rectangle { }

                NavItem {
                    icon: Icons.settings;
                    text: "Definições";
                    active: Backend.page == "settings";
                    clicked => {
                        Backend.navigate("settings");
                    }
                }

                // --- Account ---------------------------------------------------------------
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    spacing: 10px;
                    padding-top: 10px;
                    VerticalLayout {
                        alignment: center;
                        Avatar {
                            initials: Backend.user-initials;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: Backend.user-name;
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }

                        Text {
                            text: "Administrador";
                            font-size: 12px;
                            color: Theme.muted;
                        }
                    }

                    IconButton {
                        icon: Icons.log-out;
                        label: "Terminar sessão";
                        clicked => {
                            Backend.logout();
                        }
                    }
                }
            }
        }

        // --- Main area -------------------------------------------------------------------
        VerticalLayout {
            horizontal-stretch: 1;

            Rectangle {
                height: 52px;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "O meu condomínio  /  " + Backend.page-label;
                            font-size: 14px;
                            color: Theme.muted;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Espaço privado";
                            font-size: 13px;
                            color: Theme.muted;
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                padding: 28px;
                spacing: 16px;

                if Backend.update-visible: Rectangle {
                    height: update-row.preferred-height;
                    border-radius: Theme.radius;
                    background: Backend.update-required ? Theme.danger-soft : Theme.success-soft;
                    accessible-role: text;
                    accessible-label: Backend.update-text;

                    update-row := HorizontalLayout {
                        padding: 12px;
                        padding-left: 14px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: Backend.update-required ? Icons.alert : Icons.file-up;
                                tint: Backend.update-required ? Theme.danger : Theme.green-text;
                                size: 18px;
                            }
                        }

                        Text {
                            text: Backend.update-text;
                            color: Theme.text;
                            font-size: 14px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        VerticalLayout {
                            alignment: center;
                            AppButton {
                                kind: "primary";
                                text: "Ver novidades";
                                height: 32px;
                                clicked => {
                                    Backend.open-update();
                                }
                            }
                        }

                        if !Backend.update-required: VerticalLayout {
                            alignment: center;
                            AppButton {
                                text: "Mais tarde";
                                height: 32px;
                                clicked => {
                                    Backend.dismiss-update();
                                }
                            }
                        }
                    }
                }

                if Backend.notice-text != "": Notice {
                    kind: Backend.notice-kind;
                    text: Backend.notice-text;
                    dismiss => {
                        Backend.dismiss-notice();
                    }
                }
                @children
            }
        }
    }
}
