import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Backend } from "state.slint";
import { Icon, AppButton, TextField, InlineError } from "components.slint";

component Brand inherits HorizontalLayout {
    spacing: 12px;
    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: Theme.green;
        Icon {
            source: Icons.building;
            tint: Theme.on-green;
            size: 24px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: 0px;
            alignment: start;
            Text {
                text: "meu";
                font-size: 22px;
                font-weight: 700;
                color: Theme.text;
            }

            Text {
                text: "condomínio";
                font-size: 22px;
                font-weight: 300;
                color: Theme.text;
            }
        }
    }
}

// Layout shared by sign-in and first-run setup: form on the left, a quiet panel on the right.
component AuthFrame inherits Rectangle {
    in property <string> eyebrow;
    in property <string> title;
    in property <string> subtitle;
    background: Theme.page;

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 40px;
            alignment: center;
            Brand { }

            Rectangle {
                height: 40px;
            }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(420px, root.width - 80px);
                    spacing: 14px;
                    Text {
                        text: root.eyebrow;
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.green-text;
                    }

                    Text {
                        text: root.title;
                        font-size: 34px;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.subtitle;
                        font-size: 16px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }

                    @children
                }
            }

            Rectangle {
                height: 24px;
            }

            Text {
                text: "Portugal · EUR";
                font-size: 12px;
                color: Theme.muted;
            }
        }

        if root.width > 880px: Rectangle {
            width: root.width * 0.4;
            background: @linear-gradient(160deg, #17664f 0%, #0d3b2e 100%);
            VerticalLayout {
                padding: 48px;
                alignment: end;
                spacing: 8px;
                Text {
                    text: "O NOSSO ESPAÇO COMUM";
                    font-size: 12px;
                    font-weight: 700;
                    color: #b8e0d0;
                }

                Text {
                    text: "Uma casa.\nUma comunidade.";
                    font-size: 34px;
                    font-weight: 300;
                    color: #ffffff;
                }
            }
        }
    }
}

export component LoginScreen inherits AuthFrame {
    eyebrow: "ADMINISTRAÇÃO";
    title: "Bem-vindo a casa.";
    subtitle: "Entre no seu condomínio.";

    // `changed` only watches own properties, so mirror the global's counter.
    property <int> reset-token: Backend.form-reset;
    changed reset-token => {
        password.text = "";
    }
    init => {
        email.focus-field();
    }

    if Backend.form-error != "": InlineError {
        text: Backend.form-error;
    }
    email := TextField {
        label: "Email";
        accepted => {
            password.focus-field();
        }
    }

    password := TextField {
        label: "Palavra-passe";
        password: true;
        accepted => {
            Backend.login(email.text, password.text);
        }
    }

    AppButton {
        kind: "primary";
        text: Backend.busy ? "A entrar..." : "Entrar";
        enabled: !Backend.busy;
        arrow: true;
        clicked => {
            Backend.login(email.text, password.text);
        }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        padding-top: 6px;
        Icon {
            source: Icons.lock;
            tint: Theme.muted;
            size: 15px;
        }

        Text {
            text: "Acesso reservado à administração";
            font-size: 13px;
            color: Theme.muted;
        }
    }
}

export component SetupScreen inherits AuthFrame {
    eyebrow: "PRIMEIRA UTILIZAÇÃO";
    title: "Vamos começar.";
    subtitle: "Crie a conta de administração. Os dados ficam apenas neste computador.";

    property <int> reset-token: Backend.form-reset;
    changed reset-token => {
        password.text = "";
        confirm.text = "";
    }
    init => {
        name.focus-field();
    }

    if Backend.form-error != "": InlineError {
        text: Backend.form-error;
    }
    name := TextField {
        label: "Nome";
        accepted => {
            email.focus-field();
        }
    }

    email := TextField {
        label: "Email";
        accepted => {
            password.focus-field();
        }
    }

    password := TextField {
        label: "Palavra-passe (pelo menos 12 caracteres)";
        password: true;
        accepted => {
            confirm.focus-field();
        }
    }

    confirm := TextField {
        label: "Repetir palavra-passe";
        password: true;
        accepted => {
            Backend.setup(name.text, email.text, password.text, confirm.text);
        }
    }

    AppButton {
        kind: "primary";
        text: Backend.busy ? "A criar..." : "Criar administrador";
        enabled: !Backend.busy;
        arrow: true;
        clicked => {
            Backend.setup(name.text, email.text, password.text, confirm.text);
        }
    }
}
