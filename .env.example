TZ=UTC
PORT=3333
HOST=127.0.0.1
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=condo
DB_PASSWORD=
DB_DATABASE=my_condo
LIMITER_STORE=database
DB_SSL_MODE=disable
DB_POOL_MAX=5
# Outgoing email. Defaults point at a local Mailpit dev inbox (UI on http://127.0.0.1:8025):
#   docker compose -f compose.dev.yaml up -d
# For real delivery, use your SMTP relay's host/port/credentials instead.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=condo@localhost
