# Temporary HTTP access by IP. Replace with your VM's public IPv4 address.
APP_DOMAIN=http://your-vm-public-ip
# Replace with the digest published by the release workflow.
APP_IMAGE=ghcr.io/roldao-enes/my-condo@sha256:replace-with-release-digest
APP_KEY=
DB_HOST=your-managed-postgres-host
DB_PORT=5432
DB_USER=condo
DB_PASSWORD=
DB_DATABASE=my_condo
DB_SSL_MODE=verify-full
# Set the provider CA PEM if it is not publicly trusted. Literal \n is supported.
DB_SSL_CA=
DB_POOL_MAX=5